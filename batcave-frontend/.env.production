# Used by `vite build`, so production bundles point at the deployed Worker
# rather than at localhost. Committed on purpose: it is a public URL, and a
# deploy that depends on an untracked file is a deploy that breaks on another
# machine.
#
# This origin must also appear in the backend's CORS_ORIGINS var.
VITE_API_BASE_URL=https://batcave-backend.sidhant-sriv.workers.dev
