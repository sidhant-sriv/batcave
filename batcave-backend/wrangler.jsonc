{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "batcave-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  // `global_fetch_strictly_public` is required by the OAuth provider before it
  // will advertise Client ID Metadata Documents: it stops an outbound fetch of
  // a client's metadata URL from resolving to something inside the zone, which
  // is the SSRF this feature would otherwise open.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "batcave-db",
      "database_id": "43c4d147-b426-4ac3-859f-d2daaeae1b5f",
      "migrations_dir": "migrations"
    }
  ],
  // Grants, tokens and clients for the MCP server's OAuth provider. The binding
  // name is the library's, not ours.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "d86e3949fb4740249b9931b10765ffdd"
    }
  ],

  "workflows": [
    {
      "name": "batcave-task-schedule",
      "binding": "TASK_SCHEDULE",
      "class_name": "TaskScheduleWorkflow"
    }
  ],
  // Speech-to-text for the composer's microphone. Nothing else uses it.
  // `remote` is not a choice: Workers AI has no local emulation, so even
  // `wrangler dev` bills the real account. Stating it silences a warning on
  // every run and keeps that fact where someone will read it.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "GROQ_MODEL": "qwen/qwen3.8-27b",
    // Origins the browser frontend may call /api/* from. Add the Pages
    // deployment's URL here and redeploy once the project exists.
    "CORS_ORIGINS": "http://localhost:5173,https://batcave-frontend.pages.dev"
  }
}
