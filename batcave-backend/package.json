{
  "name": "batcave-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply batcave-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply batcave-db --remote",
    "db:query:local": "wrangler d1 execute batcave-db --local --command",
    "test": "vitest run",
    "test:watch": "vitest",
    "chat:eval": "./scripts/chat-eval.sh"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.14",
    "groq-sdk": "^1.2.1",
    "hono": "^4.13.5",
    "langchain": "^1.5.10",
    "langgraph-checkpoint-cloudflare-d1": "0.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
